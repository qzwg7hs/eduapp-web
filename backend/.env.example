# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/eduapp

# JWT signing — generate a real random secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudflare R2 (S3-compatible object storage) — used for lesson/test images
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default (http://localhost:5173) is used automatically if unset.
CORS_ORIGINS=https://your-app-domain.com
